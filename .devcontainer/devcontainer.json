{
  "name": "de-lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.10" }
  },
  // Tối thiểu 2-core/8 GB để tiết kiệm quota (120 core-giờ/tháng ≈ 60 giờ). Cần --profile all thì đổi máy sang 4-core.
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "forwardPorts": [8080, 8085, 8090, 8091, 9870, 4040],
  "portsAttributes": {
    "8080": { "label": "Airflow" },
    "8085": { "label": "Kafka UI" },
    "8090": { "label": "Spark master" },
    "8091": { "label": "Spark worker" },
    "9870": { "label": "HDFS NameNode" },
    "4040": { "label": "Spark job UI" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-containers",
        "mechatroner.rainbow-csv"
      ]
    }
  },
  // pyspark, delta-spark: chỉ để Pylance gợi ý code (job vẫn chạy bằng spark-submit trong container); phải khớp phiên bản cluster
  // Airflow ghi log vào ./airflow/logs nên phải chạy bằng đúng uid của user trong Codespace
  "postCreateCommand": "sed -i \"s/^AIRFLOW_UID=.*/AIRFLOW_UID=$(id -u)/\" .env && pip install kafka-python-ng requests pyspark==3.5.3 delta-spark==3.3.3"
}
